.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
scratch/
# Generated CAD output is ignored, except what a reader needs without running the code:
# pictures, check results, and the printable STL/STEP files.
**/exports/*
!**/exports/*.png
!**/exports/checks*.json
!**/exports/*.stl
!**/exports/*.step
# G-code and Orca projects are specific to one printer and profile: never commit them.
*.gcode
*.3mf
# ...except third-party source models a project is built from.
!projects/*/vendor/**
stream.pid
progress.sqlite3
# Site tokens for publish scripts (Thingiverse). Never commit.
.env
